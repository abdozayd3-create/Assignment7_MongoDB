      "name": "01 - Create Books Collection (Validation)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/collection/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "collection",
            "books"
          ]
        },
        "description": "Creates the books collection with a required, non-empty title. Run once on a fresh database."
      }
    },
