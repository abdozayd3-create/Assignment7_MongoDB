    {
      "name": "05 - Insert One Book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Book1\",\n  \"author\": \"Ali\",\n  \"year\": 1937,\n  \"genres\": [\n    \"Fantasy\",\n    \"Adventure\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "The test script stores insertedId as collection variable bookId for request 07."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  if (data.insertedId) pm.collectionVariables.set(\"bookId\", data.insertedId);",
              "}"
            ]
          }
        }
      ]
    },
